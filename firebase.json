{
  "hosting": {
    "public": "dist",          // الدليل الذي يحتوي على الملفات المنشورة (عادةً يكون dist أو build)
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/**",
        "destination": "/index.html"
      }
    ]
  }
}
