{
  "name": "yochat",
  "version": "1.0.0",
  "description": "YoChat is a global chat application using Firebase for authentication and Firestore for real-time messaging.",
  "main": "index.js",
  "scripts": {
    "start": "live-server",
    "build": "npm run clean && npm run compile",
    "clean": "rm -rf dist",
    "compile": "webpack --mode production",
    "deploy": "firebase deploy --only hosting"
  },
  "keywords": [
    "firebase",
    "chat",
    "real-time",
    "app",
    "global"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "firebase": "^9.0.0",
    "firebase-admin": "^10.0.0",
    "firebase-functions": "^3.16.0",
    "live-server": "^1.2.1",
    "webpack": "^5.24.0",
    "webpack-cli": "^4.7.0",
    "webpack-dev-server": "^4.0.0"
  },
  "devDependencies": {
    "babel-loader": "^8.2.2",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-plugin-import": "^2.24.2",
    "webpack-bundle-analyzer": "^4.4.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
